<Window x:Class="BlueOpenServer.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="#111115"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#22222b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333342"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#444456"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0c0c0e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4d90fe"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#1a1a26" Offset="0" />
                <GradientStop Color="#08080b" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Main Content Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clock & Date Section -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
            <TextBlock Name="TxtClock" 
                       Text="12:34" 
                       Foreground="#f5f5f7" 
                       FontSize="90" 
                       FontWeight="Light" 
                       FontFamily="Segoe UI Light"
                       HorizontalAlignment="Center" />
            
            <TextBlock Name="TxtDate" 
                       Text="Tuesday, June 30" 
                       Foreground="#8e8e93" 
                       FontSize="22" 
                       FontWeight="Normal" 
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Ellipse Width="8" Height="8" Fill="#4caf50" Margin="0,0,8,0" Name="StatusDot"/>
                <TextBlock Name="TxtStatus" 
                           Text="Secured via Bluetooth" 
                           Foreground="#8e8e93" 
                           FontSize="14" 
                           FontFamily="Segoe UI"/>
            </StackPanel>
        </StackPanel>

        <!-- Central Action Panel (Manual Unlock / Password Entry) -->
        <Border Grid.Row="1" 
                Width="320" 
                Background="#181822" 
                BorderBrush="#252535" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="24"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel Name="UnlockPanel">
                <!-- Lock Icon or Label -->
                <TextBlock Text="🔒 PC LOCKED" 
                           Foreground="#f5f5f7" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <TextBlock Text="Unlock with phone or enter password below" 
                           Foreground="#8e8e93" 
                           FontSize="12" 
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Password Input -->
                <PasswordBox Name="PasswordInput" 
                             Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,15"
                             KeyDown="PasswordInput_KeyDown"/>

                <!-- Unlock Button -->
                <Button Content="Unlock" 
                        Style="{StaticResource ModernButton}" 
                        Background="#3f51b5"
                        Click="Unlock_Click"/>

                <!-- Error Message -->
                <TextBlock Name="TxtError" 
                           Text="Incorrect password" 
                           Foreground="#ff3b30" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,10,0,0" 
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2" 
                   Text="BlueOpen Security Service" 
                   Foreground="#333342" 
                   FontSize="12" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Margin="0,0,0,20"/>
    </Grid>
</Window>
